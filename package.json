{
  "name": "@solvorx/sx-tool-web",
  "publicName": "SolvorX Tool Web",
  "description": "Integración de identidad de SolvorX para apps web: login, sesión persistente y logout contra sx-management-service. Cliente público (navegador) y cliente confidencial con backend propio (subpath ./server).",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.15.1",
  "license": "MIT",
  "author": "SolvorX",
  "homepage": "https://github.com/solvorx/sx-tool-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solvorx/sx-tool-web.git"
  },
  "bugs": {
    "url": "https://github.com/solvorx/sx-tool-web/issues"
  },
  "keywords": [
    "oauth",
    "oidc",
    "pkce",
    "solvorx",
    "authentication"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "oxlint",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "playground": "node scripts/serve-playground.mjs",
    "playground:build": "pnpm build && pnpm playground",
    "check:package": "pnpm build && node scripts/check-package.mjs",
    "prepublishOnly": "pnpm build && node scripts/check-package.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
